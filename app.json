{
  "expo": {
    "name": "TomoFlow",
    "slug": "tomoflow",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "scheme": "tomoflow",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#1B1D23"
    },
    "updates": {
      "fallbackToCacheTimeout": 0
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.chevslabs.tomoflow",
      "jsEngine": "hermes",
      "infoPlist": {
        "RevenueCatAPIKey": "${EXPO_PUBLIC_REVENUECAT_IOS_KEY}"
      },
      "config": {
        "googleMobileAdsAppId": "ca-app-pub-2340741129071114~2471058154"
      }
    },
    "android": {
      "package": "com.chevslabs.tomoflow",
      "jsEngine": "hermes",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#1B1D23"
      },
      "manifestPlaceholders": {
        "REVENUECAT_API_KEY": "${EXPO_PUBLIC_REVENUECAT_ANDROID_KEY}"
      },
      "config": {
        "googleMobileAdsAppId": "ca-app-pub-2340741129071114~1326439397"
      }
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "supabaseUrl": "https://zkstcywertzzooxefwuh.supabase.co",
