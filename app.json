      "revenuecatIosKey": "${EXPO_PUBLIC_REVENUECAT_IOS_KEY}",
      "revenuecatAndroidKey": "${EXPO_PUBLIC_REVENUECAT_ANDROID_KEY}",
      "admob": {
        "androidBannerUnitId": "ca-app-pub-2340741129071114/9867274393",
        "iosBannerUnitId": "ca-app-pub-2340741129071114/5746413597"
