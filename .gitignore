# React Native / Expo / Node .gitignore

# Node modules
/node_modules/
/npm-debug.log
/yarn-error.log

# Expo files
.expo/
/.expo-shared/

# Metro / Bundler
.expo/
.expo-shared/
packager-info.json
metro-cache/
.expo/web-build/

# Local env
.env
.env.* 
!.env.example

# Logs
*.log
*.log.*
logs/

# macOS files
.DS_Store

# Android build files
/android/app/build/
/android/.gradle/
/android/.idea/
/android/local.properties
/android/app/*.keystore
/android/app/**/*.keystore
/android/app/debug.keystore
/android/.cxx/

# iOS build files
/ios/build/
/ios/Pods/
/ios/*.xcworkspace
/ios/*/DerivedData/

# XCode user settings
xcuserdata/

# Generated assets
*.pem
*.p12
*.cert
*.mobileprovision
*.jks

# Expo generates
expo-env.d.ts

# Watchman
.watchmanconfig

# VS Code
.vscode/

# Fastlane
fastlane/report.xml
fastlane/Preview.html
fastlane/screenshots/**/*.png
fastlane/test_output

# Coverage
coverage/
